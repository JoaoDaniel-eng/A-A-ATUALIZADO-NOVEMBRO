{
  "name": "acai-da-roca",
  "version": "2.0.0",
  "private": true,
  "description": "Site de pedidos e painel administrativo do Açaí da Roça",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n api,web \"API_PORT=3001 node --watch src/server.js\" \"vite --host 0.0.0.0 --port 3000\"",
    "test": "node --test",
    "vapid": "node src/tools/generate-vapid-keys.js",
    "build": "tsc -b && vite build",
    "prestart": "npm run build",
    "preview:server": "npm run build && PORT=3000 node src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "6.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
